  @@index([organizationId])
  @@index([campusId])
  @@index([classSectionId])
  @@index([createdAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String               @id @default(cuid())
  organizationId String
  conversationId String
  senderId       String?
  body           String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?                @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)
  attachments    MessageAttachment[]
  readReceipts   MessageReadReceipt[]

  @@index([organizationId])
  @@index([conversationId])
  @@index([createdAt])
}

model MessageAttachment {
  id          String    @id @default(cuid())
  messageId   String
  fileAssetId String
  createdAt   DateTime  @default(now())
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@unique([messageId, fileAssetId])
  @@index([messageId])
}

model MessageReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  channel        NotificationChannel @default(IN_APP)
  title          String
  body           String?
  actionUrl      String?
  entityType     String?
  entityId       String?
  data           Json?
  readAt         DateTime?
  archivedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
}

model NotificationPreference {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  channel        NotificationChannel
  enabled        Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@index([organizationId])
  @@index([userId])
}

model AcademicPolicy {
  id             String        @id @default(cuid())
  organizationId String
  campusId       String?
  classSectionId String?
  name           String
  effectiveFrom  DateTime?
  effectiveUntil DateTime?
  settings       Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus?       @relation(fields: [campusId], references: [id], onDelete: SetNull)
  classSection   ClassSection? @relation(fields: [classSectionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([campusId])
  @@index([classSectionId])
  @@index([createdAt])
}

model AttendancePolicy {
  id                  String        @id @default(cuid())
  organizationId      String
  campusId            String?
  classSectionId      String?
  name                String
  lateAfterMinutes    Int?
  absenceAfterMinutes Int?
  settings            Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus              Campus?       @relation(fields: [campusId], references: [id], onDelete: SetNull)
  classSection        ClassSection? @relation(fields: [classSectionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([campusId])
  @@index([classSectionId])
  @@index([createdAt])
}

model VideoCompletionPolicy {
  id                 String        @id @default(cuid())
  organizationId     String
  campusId           String?
  classSectionId     String?
  name               String
  requiredPercentage Decimal       @default(90) @db.Decimal(5, 2)
  settings           Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus             Campus?       @relation(fields: [campusId], references: [id], onDelete: SetNull)
  classSection       ClassSection? @relation(fields: [classSectionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([campusId])
  @@index([classSectionId])
  @@index([createdAt])
}

model GradingPolicy {
  id             String        @id @default(cuid())
  organizationId String
  campusId       String?
  classSectionId String?
  name           String
  gpaScale       Decimal?      @db.Decimal(4, 2)
  settings       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus?       @relation(fields: [campusId], references: [id], onDelete: SetNull)
  classSection   ClassSection? @relation(fields: [classSectionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([campusId])
  @@index([classSectionId])
  @@index([createdAt])
}

model MessagingPolicy {
  id                         String       @id @default(cuid())
  organizationId             String
  name                       String
  allowStudentDirectMessages Boolean      @default(false)
  settings                   Json?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
}

model FileAsset {
  id                     String                @id @default(cuid())
  organizationId         String
  campusId               String?
  classSectionId         String?
  uploadedById           String?
  bucket                 String
  objectKey              String
  originalName           String
  contentType            String?
  byteSize               BigInt?
  checksum               String?
  visibility             FileVisibility        @default(PRIVATE)
  metadata               Json?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus                 Campus?               @relation(fields: [campusId], references: [id], onDelete: SetNull)
  classSection           ClassSection?         @relation(fields: [classSectionId], references: [id], onDelete: SetNull)
  uploadedBy             User?                 @relation("UploadedFiles", fields: [uploadedById], references: [id], onDelete: SetNull)
  avatarUsers            User[]                @relation("UserAvatar")
  logoOrganizations      Organization[]        @relation("OrganizationLogo")
  lessons                Lesson[]
  learningMaterials      LearningMaterial[]
  assignmentSubmission   AssignmentSubmission? @relation(fields: [assignmentSubmissionId], references: [id], onDelete: SetNull)
  assignmentSubmissionId String?
  postAttachments        PostAttachment[]
  commentAttachments     CommentAttachment[]
  messageAttachments     MessageAttachment[]
  generatedDocuments     GeneratedDocument[]

  @@unique([bucket, objectKey])
  @@index([organizationId])
  @@index([campusId])
  @@index([classSectionId])
  @@index([createdAt])
}
