generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InstitutionType {
  ELEMENTARY
  MIDDLE
  HIGH
  UNIVERSITY
  ACADEMY
  CORPORATE
  ONLINE_SCHOOL
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  SCHOOL_ADMIN
  ACADEMIC_STAFF
  INSTRUCTOR
  HOMEROOM_TEACHER
  STUDENT
  PARENT
}

enum DeliveryMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  ABSENT
  EXCUSED
  SICK_LEAVE
  OFFICIAL_ABSENCE
  PENDING
}

enum EnrollmentStatus {
  ENROLLED
  DROPPED
  COMPLETED
  WITHDRAWN
}

enum LessonContentType {
  VIDEO
  TEXT
  FILE
  QUIZ
  ASSIGNMENT
  LIVE_SESSION
}

enum VideoProvider {
  HTML5
  YOUTUBE
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
}

enum FinalGradeStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  PUBLISHED
  FINALIZED
  CORRECTION_REQUESTED
  CORRECTED
}

enum DocumentType {
  REPORT_CARD
  TRANSCRIPT
  CERTIFICATE
  ATTENDANCE_REPORT
}

enum DocumentStatus {
  PENDING
  GENERATED
  FAILED
  VOIDED
}

enum BoardType {
  NOTICE
  GENERAL
  QNA
  MATERIAL
  HOMEROOM
  CLASS_SECTION
}

enum BoardScopeType {
  ORGANIZATION
  CAMPUS
  GRADE_LEVEL
  HOMEROOM
  CLASS_SECTION
}

enum ConversationType {
  DIRECT
  GROUP
  HOMEROOM
  CLASS_SECTION
  SUPPORT
}

enum NotificationType {
  NEW_POST
  NEW_COMMENT
  NEW_BOARD_POST
  NEW_BOARD_COMMENT
  NEW_MESSAGE
  ASSIGNMENT_DUE
  NEW_ASSIGNMENT
  ASSIGNMENT_SUBMITTED
  ASSIGNMENT_GRADED
  QUIZ_OPENED
  NEW_QUIZ
  QUIZ_GRADED
  GRADE_PUBLISHED
  FINAL_GRADE_PUBLISHED
  REPORT_CARD_AVAILABLE
  TRANSCRIPT_AVAILABLE
  ATTENDANCE_CHANGED
  ATTENDANCE_UPDATED
  SYSTEM_NOTICE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  KAKAO
}

enum FileVisibility {
  PRIVATE
  ORGANIZATION
  CLASS_SECTION
  PUBLIC
}

enum UserDeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Organization {
  id                      String                   @id @default(cuid())
  name                    String
  slug                    String                   @unique
  institutionType         InstitutionType
  logoFileAssetId         String?
  websiteUrl              String?
  defaultLocale           String                   @default("ko-KR")
  timezone                String                   @default("Asia/Seoul")
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  logoFileAsset           FileAsset?                @relation("OrganizationLogo", fields: [logoFileAssetId], references: [id], onDelete: SetNull)
  campuses                Campus[]
  users                   User[]
  roleAssignments         UserRoleAssignment[]
  academicYears           AcademicYear[]
  terms                   Term[]
  gradeLevels             GradeLevel[]
  homerooms               Homeroom[]
  departments             Department[]
  programs                Program[]
  subjects                Subject[]
  courses                 Course[]
  classSections           ClassSection[]
  classSessions           ClassSession[]
  enrollments             Enrollment[]
  lessons                 Lesson[]
  learningMaterials       LearningMaterial[]
  videoProgress           VideoProgress[]
  attendanceSessions      AttendanceSession[]
  attendanceRecords       AttendanceRecord[]
  assignments             Assignment[]
  submissions             AssignmentSubmission[]
  quizzes                 Quiz[]
  questions               Question[]
  quizAttempts            QuizAttempt[]
  exams                   Exam[]
  gradeCategories         GradeCategory[]
  gradeItems              GradeItem[]
  gradeScores             GradeScore[]
  gradingScales           GradingScale[]
  finalGrades             FinalGrade[]
  transcripts             Transcript[]
  transcriptTerms         TranscriptTerm[]
  transcriptItems         TranscriptItem[]
  reportCards             ReportCard[]
  reportCardItems         ReportCardItem[]
  generatedDocuments      GeneratedDocument[]
  boards                  Board[]
  posts                   Post[]
  comments                Comment[]
  conversations           Conversation[]
  messages                Message[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  auditLogs               AuditLog[]
  academicPolicies        AcademicPolicy[]
  attendancePolicies      AttendancePolicy[]
  videoCompletionPolicies VideoCompletionPolicy[]
  gradingPolicies         GradingPolicy[]
  messagingPolicies       MessagingPolicy[]
  fileAssets              FileAsset[]
  studentProfiles         StudentProfile[]
  instructorProfiles      InstructorProfile[]
  parentStudentRelations  ParentStudentRelation[]
  classSectionInstructors ClassSectionInstructor[]
  userDeletionRequests    UserDeletionRequest[]

  @@index([institutionType])
  @@index([logoFileAssetId])
  @@index([createdAt])
}

model Campus {
  id                      String                  @id @default(cuid())
  organizationId          String
  name                    String
  code                    String?
  address                 String?
  phone                   String?
  isActive                Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleAssignments         UserRoleAssignment[]
  studentProfiles         StudentProfile[]
  instructorProfiles      InstructorProfile[]
  academicYears           AcademicYear[]
  terms                   Term[]
  gradeLevels             GradeLevel[]
  homerooms               Homeroom[]
  departments             Department[]
  programs                Program[]
  courses                 Course[]
  classSections           ClassSection[]
  classSessions           ClassSession[]
  enrollments             Enrollment[]
  attendanceSessions      AttendanceSession[]
  attendanceRecords       AttendanceRecord[]
  academicPolicies        AcademicPolicy[]
  attendancePolicies      AttendancePolicy[]
  videoCompletionPolicies VideoCompletionPolicy[]
  gradingPolicies         GradingPolicy[]
  boards                  Board[]
  conversations           Conversation[]
  fileAssets              FileAsset[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([createdAt])
}

model User {
  id                          String                    @id @default(cuid())
  organizationId              String
  email                       String?
  username                    String?
  passwordHash                String?
  name                        String
  phone                       String?
  avatarFileAssetId           String?
  isActive                    Boolean                   @default(true)
  lastLoginAt                 DateTime?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  organization                Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  avatarFileAsset             FileAsset?                @relation("UserAvatar", fields: [avatarFileAssetId], references: [id], onDelete: SetNull)
  roleAssignments             UserRoleAssignment[]
  studentProfile              StudentProfile?
  instructorProfile           InstructorProfile?
  parentRelations             ParentStudentRelation[]   @relation("ParentRelations")
  studentParentRelations      ParentStudentRelation[]   @relation("StudentRelations")
  sectionInstructors          ClassSectionInstructor[]
  enrollments                 Enrollment[]
  createdLessons              Lesson[]                  @relation("LessonCreator")
  videoProgress               VideoProgress[]
  attendanceRecords           AttendanceRecord[]
  assignmentSubmissions       AssignmentSubmission[]
  gradedAssignmentSubmissions AssignmentSubmission[]    @relation("GradedAssignmentSubmissions")
  gradedQuizAttempts          QuizAttempt[]             @relation("GradedQuizAttempts")
  gradedQuizAnswers           QuizAnswer[]              @relation("GradedQuizAnswers")
  gradedGradeScores           GradeScore[]              @relation("GradedGradeScores")
  quizAttempts                QuizAttempt[]
  quizAnswers                 QuizAnswer[]
  gradeScores                 GradeScore[]
  finalGrades                 FinalGrade[]
  transcripts                 Transcript[]
  reportCards                 ReportCard[]
  generatedDocuments          GeneratedDocument[]
  posts                       Post[]
  comments                    Comment[]
  conversationParticipants    ConversationParticipant[]
  sentMessages                Message[]                 @relation("SentMessages")
  readReceipts                MessageReadReceipt[]
  notifications               Notification[]
  notificationPreferences     NotificationPreference[]
  auditLogs                   AuditLog[]                 @relation("AuditActor")
  uploadedFiles               FileAsset[]               @relation("UploadedFiles")
  homerooms                   Homeroom[]
  deletionRequestsRequested   UserDeletionRequest[]    @relation("UserDeletionRequestedBy")
  deletionRequestsReviewed    UserDeletionRequest[]    @relation("UserDeletionReviewedBy")
  deletionRequestsTargeted    UserDeletionRequest[]    @relation("UserDeletionTarget")

  @@unique([organizationId, email])
  @@unique([organizationId, username])
  @@index([organizationId])
  @@index([createdAt])
}

model UserDeletionRequest {
  id                String                    @id @default(cuid())
  organizationId    String
  targetUserId      String?
  requestedById     String?
  reviewedById      String?
  targetUserName    String
  targetUserLoginId String?
  reason            String?
  status            UserDeletionRequestStatus @default(PENDING)
  requestedAt       DateTime                  @default(now())
  reviewedAt        DateTime?
  updatedAt         DateTime                  @updatedAt
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetUser        User?                     @relation("UserDeletionTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  requestedBy       User?                     @relation("UserDeletionRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy        User?                     @relation("UserDeletionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([targetUserId])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
  @@index([requestedAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  campusId       String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  summary        String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([campusId])
  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model UserRoleAssignment {
  id             String       @id @default(cuid())
  organizationId String
  campusId       String?
  userId         String
  role           UserRole
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([campusId])
  @@index([userId])
  @@index([role])
  @@index([createdAt])
}

model StudentProfile {
  id                  String       @id @default(cuid())
  organizationId      String
  campusId            String?
  userId              String       @unique
  studentNumber       String?
  admissionDate       DateTime?
  graduationDate      DateTime?
  currentGradeLevelId String?
  homeroomId          String?
  metadata            Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus              Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentGradeLevel   GradeLevel?  @relation(fields: [currentGradeLevelId], references: [id], onDelete: SetNull)
  homeroom            Homeroom?    @relation(fields: [homeroomId], references: [id], onDelete: SetNull)

  @@unique([organizationId, studentNumber])
  @@index([organizationId])
  @@index([campusId])
  @@index([homeroomId])
}

model InstructorProfile {
  id             String       @id @default(cuid())
  organizationId String
  campusId       String?
  userId         String       @unique
  employeeNumber String?
  title          String?
  bio            String?
  hireDate       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, employeeNumber])
  @@index([organizationId])
  @@index([campusId])
}

model ParentStudentRelation {
  id             String       @id @default(cuid())
  organizationId String
  parentId       String
  studentId      String
  relation       String
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         User         @relation("ParentRelations", fields: [parentId], references: [id], onDelete: Cascade)
  student        User         @relation("StudentRelations", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([organizationId])
  @@index([studentId])
  @@index([createdAt])
}

model AcademicYear {
  id             String         @id @default(cuid())
  organizationId String
  campusId       String?
  name           String
  startsAt       DateTime
  endsAt         DateTime
  isActive       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus?        @relation(fields: [campusId], references: [id], onDelete: SetNull)
  terms          Term[]
  gradeLevels    GradeLevel[]
  homerooms      Homeroom[]
  classSections  ClassSection[]
  reportCards    ReportCard[]
  transcripts    Transcript[]

  @@index([organizationId])
  @@index([campusId])
  @@index([createdAt])
}

model Term {
  id              String           @id @default(cuid())
  organizationId  String
  campusId        String?
  academicYearId  String
  name            String
  startsAt        DateTime
  endsAt          DateTime
  sequence        Int              @default(1)
  isActive        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus          Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classSections   ClassSection[]
  classSessions   ClassSession[]
  gradeCategories GradeCategory[]
  gradeItems      GradeItem[]
  finalGrades     FinalGrade[]
  transcriptTerms TranscriptTerm[]
  reportCards     ReportCard[]

  @@index([organizationId])
  @@index([campusId])
  @@index([academicYearId])
  @@index([createdAt])
}

model GradeLevel {
  id              String           @id @default(cuid())
  organizationId  String
  campusId        String?
  academicYearId  String?
  name            String
  code            String?
  sequence        Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus          Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicYear    AcademicYear?    @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  studentProfiles StudentProfile[]
  homerooms       Homeroom[]
  classSections   ClassSection[]
  boards          Board[]

  @@index([organizationId])
  @@index([campusId])
  @@index([academicYearId])
}

model Homeroom {
  id              String           @id @default(cuid())
  organizationId  String
  campusId        String?
  academicYearId  String
  gradeLevelId    String?
  name            String
  teacherId       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus          Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradeLevel      GradeLevel?      @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  teacher         User?            @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  studentProfiles StudentProfile[]
  classSections   ClassSection[]
  boards          Board[]
  conversations   Conversation[]

  @@index([organizationId])
  @@index([campusId])
  @@index([teacherId])
  @@index([createdAt])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  campusId       String?
  name           String
  code           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  programs       Program[]
  subjects       Subject[]
  courses        Course[]

  @@index([organizationId])
  @@index([campusId])
}

model Program {
  id             String       @id @default(cuid())
  organizationId String
  campusId       String?
  departmentId   String?
  name           String
  code           String?
  degreeType     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  courses        Course[]
  transcripts    Transcript[]

  @@index([organizationId])
  @@index([campusId])
  @@index([departmentId])
}

model Subject {
  id             String       @id @default(cuid())
  organizationId String
  departmentId   String?
  name           String
  code           String?
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  courses        Course[]

  @@index([organizationId])
  @@index([departmentId])
}

model Course {
  id                  String         @id @default(cuid())
  organizationId      String
  campusId            String?
  departmentId        String?
  programId           String?
  subjectId           String?
  code                String?
  title               String
  description         String?
  credits             Decimal?       @db.Decimal(5, 2)
  defaultDeliveryMode DeliveryMode   @default(OFFLINE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus              Campus?        @relation(fields: [campusId], references: [id], onDelete: SetNull)
  department          Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  program             Program?       @relation(fields: [programId], references: [id], onDelete: SetNull)
  subject             Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  classSections       ClassSection[]

  @@index([organizationId])
  @@index([campusId])
  @@index([departmentId])
  @@index([programId])
  @@index([subjectId])
}

model ClassSection {
  id                      String                     @id @default(cuid())
  organizationId          String
  campusId                String?
  academicYearId          String
  termId                  String?
  courseId                String
  gradeLevelId            String?
  homeroomId              String?
  name                    String
  sectionCode             String?
  deliveryMode            DeliveryMode               @default(OFFLINE)
  capacity                Int?
  startsAt                DateTime?
  endsAt                  DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  organization            Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus                  Campus?                    @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicYear            AcademicYear               @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term                    Term?                      @relation(fields: [termId], references: [id], onDelete: SetNull)
  course                  Course                     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  gradeLevel              GradeLevel?                @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  homeroom                Homeroom?                  @relation(fields: [homeroomId], references: [id], onDelete: SetNull)
  instructors             ClassSectionInstructor[]
  enrollments             Enrollment[]
  sessions                ClassSession[]
  lessons                 Lesson[]
  attendanceSessions      AttendanceSession[]
  assignments             Assignment[]
  quizzes                 Quiz[]
  exams                   Exam[]
  gradingConfig           ClassSectionGradingConfig?
  academicPolicies        AcademicPolicy[]
  attendancePolicies      AttendancePolicy[]
  videoCompletionPolicies VideoCompletionPolicy[]
  gradingPolicies         GradingPolicy[]
  gradeCategories         GradeCategory[]
  gradeItems              GradeItem[]
  finalGrades             FinalGrade[]
  boards                  Board[]
  conversations           Conversation[]
  fileAssets              FileAsset[]

  @@index([organizationId])
  @@index([campusId])
  @@index([academicYearId])
  @@index([termId])
  @@index([courseId])
  @@index([gradeLevelId])
  @@index([homeroomId])
  @@index([createdAt])
}

model ClassSectionGradingConfig {
  id                String       @id @default(cuid())
  classSectionId    String       @unique
  lessonsWeight     Decimal      @default(10) @db.Decimal(5, 2)
  attendanceWeight  Decimal      @default(20) @db.Decimal(5, 2)
  assignmentsWeight Decimal      @default(30) @db.Decimal(5, 2)
  quizzesWeight     Decimal      @default(20) @db.Decimal(5, 2)
  examsWeight       Decimal      @default(20) @db.Decimal(5, 2)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  classSection      ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model ClassSectionInstructor {
  id             String       @id @default(cuid())
  organizationId String
  classSectionId String
  instructorId   String
  roleLabel      String?
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  instructor     User         @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([classSectionId, instructorId])
  @@index([organizationId])
  @@index([classSectionId])
  @@index([instructorId])
}

model Enrollment {
  id             String           @id @default(cuid())
  organizationId String
  campusId       String?
  classSectionId String
  studentId      String
  status         EnrollmentStatus @default(ENROLLED)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  droppedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  classSection   ClassSection     @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  student        User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classSectionId, studentId])
  @@index([organizationId])
  @@index([campusId])
  @@index([classSectionId])
  @@index([studentId])
  @@index([createdAt])
}

model ClassSession {
  id                String             @id @default(cuid())
  organizationId    String
  campusId          String?
  classSectionId    String
  termId            String?
  title             String?
  startsAt          DateTime
  endsAt            DateTime?
  deliveryMode      DeliveryMode       @default(OFFLINE)
  location          String?
  meetingUrl        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus            Campus?            @relation(fields: [campusId], references: [id], onDelete: SetNull)
  classSection      ClassSection       @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  term              Term?              @relation(fields: [termId], references: [id], onDelete: SetNull)
  attendanceSession AttendanceSession?

  @@index([organizationId])
  @@index([campusId])
  @@index([classSectionId])
  @@index([termId])
  @@index([createdAt])
}

model Lesson {
  id               String             @id @default(cuid())
  organizationId   String
  classSectionId   String
  createdById      String?
  title            String
  description      String?
  sequence         Int                @default(1)
  contentType      LessonContentType  @default(TEXT)
